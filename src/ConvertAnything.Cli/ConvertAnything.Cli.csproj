<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ca</AssemblyName>
    <RootNamespace>ConvertAnything.Cli</RootNamespace>
    <AssemblyTitle>ConvertAnything</AssemblyTitle>
    <Product>ConvertAnything</Product>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DOTNET_STARTUP_HOOKS would let anything that sets an environment variable inject code into a trusted batch leader. -->
    <StartupHookSupport>false</StartupHookSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConvertAnything.Core\ConvertAnything.Core.csproj" />
  </ItemGroup>

</Project>
