<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>flevert</AssemblyName>
    <RootNamespace>Flevert.Cli</RootNamespace>
    <AssemblyTitle>Flevert</AssemblyTitle>
    <Product>Flevert</Product>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shown in the right-click menu, the progress window, the tray and Installed apps. Drawn by assets/make_icon.py. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- DOTNET_STARTUP_HOOKS would let anything that sets an environment variable inject code into a trusted batch leader. -->
    <StartupHookSupport>false</StartupHookSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The menu and PDF tools icons (assets/menu, Fluent UI System Icons, MIT; scripts/make-menu-icons.py), beside
         flevert.exe in icons\: install-menu points the menu there, and the installer packs the folder with the rest. -->
    <None Include="..\..\assets\menu\*.ico" Link="icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flevert.Core\Flevert.Core.csproj" />
    <ProjectReference Include="..\Flevert.Image\Flevert.Image.csproj" />
    <ProjectReference Include="..\Flevert.Pdf\Flevert.Pdf.csproj" />
    <ProjectReference Include="..\Flevert.Media\Flevert.Media.csproj" />
  </ItemGroup>

</Project>
