<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sentence-style test names read as specifications. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flevert.Pdf\Flevert.Pdf.csproj" />
    <!-- Build order only: FlevertExeTests launches the real flevert.exe. -->
    <ProjectReference Include="..\..\src\Flevert.Cli\Flevert.Cli.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The phone portrait with GPS of the image tests (its README tells how it was made), shared rather than copied. -->
    <None Include="..\Flevert.Image.Tests\fixtures\portrait-gps.heic" Link="fixtures\portrait-gps.heic" CopyToOutputDirectory="PreserveNewest" />
    <!-- Multi-page TIFFs as scanners write them (same README), for images to PDF. -->
    <None Include="..\Flevert.Image.Tests\fixtures\pages-with-thumbnails.tif" Link="fixtures\pages-with-thumbnails.tif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Flevert.Image.Tests\fixtures\mixed-g4-colour.tif" Link="fixtures\mixed-g4-colour.tif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
