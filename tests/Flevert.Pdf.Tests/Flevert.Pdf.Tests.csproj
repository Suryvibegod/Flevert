<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Sentence-style test names read as specifications. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- UI Automation (UIAutomationClient) for the watermark dialog test. -->
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <!-- [WindowsFact] and [WindowsTheory]: tests of Windows behaviour, skipped on Linux. -->
    <Compile Include="..\Shared\PlatformFacts.cs" Link="PlatformFacts.cs" />
    <Compile Include="..\Shared\BuiltFlevert.cs" Link="BuiltFlevert.cs" />
    <Using Include="Flevert.Tests" />
    <Using Include="System.Runtime.Versioning" />
    <Using Include="Xunit" />
    <!-- UseWPF leaves System.IO out of the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flevert.Pdf\Flevert.Pdf.csproj" />
    <!-- Build order only: FlevertExeTests launches the real flevert.exe (flevert on Linux). -->
    <ProjectReference Include="..\..\src\Flevert.Cli\Flevert.Cli.csproj" ReferenceOutputAssembly="false" Condition="'$(OS)' == 'Windows_NT'" />
    <ProjectReference Include="..\..\src\Flevert.Linux\Flevert.Linux.csproj" ReferenceOutputAssembly="false" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>
  <!-- Flevert.Linux is in the solution without being built by it (on Windows it could not reference the libraries built
       for Windows), and a solution build skips references to projects it does not build: built anyway, through this one. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>false</OnlyReferenceAndBuildProjectsEnabledInSolutionConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <None Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The phone portrait with GPS of the image tests (its README tells how it was made), shared rather than copied. -->
    <None Include="..\Flevert.Image.Tests\fixtures\portrait-gps.heic" Link="fixtures\portrait-gps.heic" CopyToOutputDirectory="PreserveNewest" />
    <!-- Multi-page TIFFs as scanners write them (same README), for images to PDF. -->
    <None Include="..\Flevert.Image.Tests\fixtures\pages-with-thumbnails.tif" Link="fixtures\pages-with-thumbnails.tif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Flevert.Image.Tests\fixtures\mixed-g4-colour.tif" Link="fixtures\mixed-g4-colour.tif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows only: the WinForms watermark dialog, driven through UI Automation. Not built on Linux (docs/specs/linux.md). -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="WatermarkWindowTests.cs" />
  </ItemGroup>

</Project>
