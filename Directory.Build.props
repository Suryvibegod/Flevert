<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The one place the version is set; the installer reads it back from flevert.exe. -->
    <Version>1.2.3</Version>
    <Authors>Flevert contributors</Authors>
    <Company>Flevert contributors</Company>
    <Copyright>Copyright (c) 2026 Flevert contributors</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
