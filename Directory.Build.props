<Project>
  <PropertyGroup>
    <!-- The Windows app on Windows; the Linux app (Nautilus menu) elsewhere. docs/specs/linux.md -->
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <!-- The one place the version is set; the installer reads it back from flevert.exe. -->
    <Version>1.3.0</Version>
    <Authors>Flevert contributors</Authors>
    <Company>Flevert contributors</Company>
    <Copyright>Copyright (c) 2026 Flevert contributors</Copyright>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
